/* pages/sell/stock/list.wxss */
@import "/utils/window.wxss";
@import "/utils/tabel.wxss";
@import "/utils/panel.wxss";

/**
 * 库存/补酒页面
 */
.page>.pmain {
    height: calc(100% - 120rpx);
}

.page>.pmain .wrapper>.list>.item {
    width: calc(100% - 80rpx);
    padding: 20rpx;
    margin: 10rpx 20rpx;
    border-radius: 10rpx;
}

.page>.pmain .wrapper>.list>.item>.row>.pic {
    width: 160rpx;
    height: 160rpx;
    border: 3rpx solid #999999;
}

.page>.pmain .wrapper>.list>.item>.row>.info {
    width: calc(100% - 180rpx);
}

.page>.pfoot {
    height: 120rpx;
}

.page>.pfoot>.button-group {
    width: calc(100% - 60rpx);
    height: calc(100% - 20rpx);
    padding: 10rpx 30rpx;
}

.page>.pfoot>.button-group>.btn {
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 8rpx;
}

.page>.pfoot>.button-group>.btn.add-wine {
    width: 320rpx;
    height: 60rpx;
}