<!--store/pages/relation/scancode.wxml-->
<import src="/store/pages/template/commons" />
<wxs src="/app.wxs" module="app" />

<!--
  -- 关联酒商码
  -->

<!-- Step 1-1 2-1 扫热点唯一码 -->
<view wx:if="{{scan_code_step==0}}" class="page scan-goods container theme-main">
    <view class="main full-container">
        <view class="warper full-container flex_column_center_center">
            <view class="panel scan flex_column_center_flexStart">
                <view class="body flex_column_center_center" bindtap="scanCode" data-type='hotspot'>
                    <view class="btn flex_column_center_center theme-button-blue">
                        <view class="icon fa fa-qrcode" aria-hidden="true"></view>
                        <view class="text">扫码</view>
                    </view>
                </view>
                <view class="title-bar flex_row_center_center">
                    <view class="title big">请扫描商品唯一标识（热点码）</view>
                </view>
            </view>
        </view>
    </view>
</view>

<!-- Step 1-2 扫酒商码 -->
<view wx:if="{{scan_code_step==11}}" class="page step-1-2 scan-goods container theme-main">
    <view class="main full-container">
        <view class="warper full-container flex_column_center_flexStart">
            <template is="goodsPanel" data='{{title:"当前扫码商品信息", list:goodsList}}' />

            <view class="panel scan flex_column_center_flexStart">
                <view class="body flex_column_center_center" bindtap="scanCode" data-type="vintner">
                    <view class="btn flex_column_center_center theme-button-blue">
                        <view class="icon fa fa-qrcode" aria-hidden="true"></view>
                        <view class="text">扫码</view>
                    </view>
                </view>
                <view class="title-bar flex_row_center_center">
                    <view class="title big">请扫描酒商防伪码进行关联</view>
                </view>
            </view>
        </view>
    </view>
</view>

<!-- Step 1-3 扫酒商码 关联 -->
<view wx:if="{{scan_code_step==12}}" class="page step-1-3 scan-goods container theme-main">
    <scroll-view class="main" scroll-y="true" scroll-with-animation="true">
        <view class="warper flex_column_center_flexStart">
            <template is="goodsPanel" data='{{title:"当前扫码商品信息", list:goodsList}}' />

            <view class="panel wine-code">
                <view class="title-bar flex_row_center_flexStart">
                    <view class="title big theme-font1">当前酒商防伪码</view>
                </view>
                <view class="body">

                    <view class="item flex_column_center_flexStart">
                        <view class="row flex_row_center_spaceBetween">
                            <view class="center flex_column_center_center">
                                <view class="name theme-font1">{{scan_code_info.winecode}}</view>
                            </view>
                        </view>
                    </view>

                </view>
            </view>
        </view>
    </scroll-view>
    <view class="foot flex_row_center_spaceAround">
        <button disabled="{{addDisable}}" class="btn cancel flex_row_center_center theme-button-disable" bindtap="cancelRelation">取消关联</button>
        <button disabled="{{addDisable}}" class="btn ok flex_row_center_center theme-button-blue" bindtap="submitInfo">保存并继续</button>
    </view>
</view>

<!-- Step 2-2 拍酒商码 -->
<view wx:if="{{scan_code_step==21}}" class="page step-2-2 scan-goods container theme-main">
    <view class="main full-container">
        <view class="warper full-container flex_column_center_flexStart">
            <template is="goodsPanel" data='{{title:"当前扫码商品信息", list:goodsList}}' />

            <view class="panel scan flex_column_center_flexStart">
                <view class="body flex_column_center_center" bindtap="addPic">
                    <view class="btn flex_column_center_center theme-button-blue">
                        <view class="icon fa fa-camera" aria-hidden="true"></view>
                        <view class="text">拍照</view>
                    </view>
                </view>
                <view class="title-bar flex_row_center_center">
                    <view class="title big">请上传对方小程序防伪页面截图</view>
                </view>
            </view>
        </view>
    </view>
</view>

<!-- Step 2-3 拍酒商码 关联 -->
<view wx:if="{{scan_code_step==22}}" class="page step-2-3 scan-goods container theme-main">
    <scroll-view class="main" scroll-y="true" scroll-with-animation="true">
        <view class="warper flex_column_center_flexStart">
            <template is="goodsPanel" data='{{title:"当前扫码商品信息", list:goodsList}}' />

            <view class="panel wine-code">
                <view class="title-bar flex_row_center_flexStart">
                    <view class="title big theme-font1">当前商品酒商防伪码</view>
                </view>
                <view class="body">

                    <!--
                    <view class="item flex_column_center_flexStart">
                        <image class="full-width" src="https://oss.littlehotspot.com/WeChat/resource/default.jpg" mode="widthFix" />
                    </view>
                    -->
                    <view class="item flex_column_center_flexStart">
                        <view class="row flex_row_center_spaceBetween">
                            <view class="center flex_column_center_center">
                                <view class="property name text theme-font1">
                                    <view class="value full-container">
                                        <view class="frame border flex_row_center_center">
                                            <input type="text" class="form text full-container" value="{{scan_code_info.winecode}}" bindinput="inputWinecode" />
                                        </view>
                                    </view>
                                </view>
                            </view>
                            <!--
                            <view class="right flex_column_center_center">
                                <view class="btn edit flex_column_center_center" bindtap="修改值">
                                    <view class="icon fa fa-pencil-square-o text big9 theme-font-FFAA2C"></view>
                                </view>
                            </view>
                            -->
                        </view>
                    </view>

                </view>
            </view>
        </view>
    </scroll-view>
    <view class="foot flex_row_center_spaceAround">
        <button disabled="{{addDisable}}" class="btn cancel flex_row_center_center theme-button-disable" bindtap="cancelRelation">取消关联</button>
        <button disabled="{{addDisable}}" class="btn ok flex_row_center_center theme-button-blue" bindtap="submitInfo">保存并继续</button>
    </view>
</view>